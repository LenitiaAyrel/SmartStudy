<?xml version="1.0" encoding="utf-8"?>

<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F7F5FC"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:padding="24dp">

        <!-- Header -->

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Study Session"
            android:textSize="28sp"
            android:textStyle="bold"
            android:textColor="#222222"
            android:layout_marginTop="30dp"
            android:layout_marginBottom="8dp" />

        <TextView
            android:id="@+id/tvSubject"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Study Session"
            android:textSize="17sp"
            android:textStyle="bold"
            android:textColor="#6B4FB3"
            android:layout_marginBottom="24dp" />


        <!-- Timer Card -->

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="20dp"
            app:cardBackgroundColor="#FFFFFF"
            app:cardCornerRadius="24dp"
            app:cardElevation="2dp"
            app:strokeColor="#E3DCF4"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center"
                android:padding="30dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="FOCUS TIME"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:textColor="#999999"
                    android:letterSpacing="0.12"
                    android:layout_marginBottom="8dp" />

                <TextView
                    android:id="@+id/tvTimer"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="25:00"
                    android:textSize="52sp"
                    android:textStyle="bold"
                    android:textColor="#6F4DBF"
                    android:layout_marginBottom="8dp" />

                <TextView
                    android:id="@+id/tvStatus"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Session Running"
                    android:textSize="15sp"
                    android:textColor="#666666" />

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>


        <!-- Completion Message -->

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="20dp"
            app:cardBackgroundColor="#FFFFFF"
            app:cardCornerRadius="20dp"
            app:cardElevation="1dp"
            app:strokeColor="#E3DCF4"
            app:strokeWidth="1dp">

            <TextView
                android:id="@+id/tvCompletionMessage"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Great work! Keep it up!"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="#333333"
                android:gravity="center"
                android:padding="24dp"
                android:visibility="gone" />

        </com.google.android.material.card.MaterialCardView>


        <!-- Pause Button -->

        <Button
            android:id="@+id/btnPause"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Pause"
            android:textAllCaps="false"
            android:textSize="16sp"
            android:layout_marginBottom="12dp" />


        <!-- Stop Button -->

        <Button
            android:id="@+id/btnStop"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Stop Session"
            android:textAllCaps="false"
            android:textSize="16sp"
            android:layout_marginBottom="12dp" />


        <!-- Study Again -->

        <Button
            android:id="@+id/btnStudyAgain"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Study Again"
            android:textAllCaps="false"
            android:textSize="16sp"
            android:visibility="gone"
            android:layout_marginBottom="12dp" />


        <!-- Back to Home -->

        <Button
            android:id="@+id/btnHome"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Back to Home"
            android:textAllCaps="false"
            android:textSize="16sp"
            android:visibility="gone" />

    </LinearLayout>

</ScrollView>

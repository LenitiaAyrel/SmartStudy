<?xml version="1.0" encoding="utf-8"?>

<resources>

    <!-- Main SmartStudy light theme -->
    <style
        name="Base.Theme.SmartStudy"
        parent="Theme.Material3.Light.NoActionBar">

        <!-- Main colors -->
        <item name="colorPrimary">#6B4FB3</item>
        <item name="colorOnPrimary">#FFFFFF</item>

        <!-- App background -->
        <item name="android:windowBackground">#F7F5FC</item>

        <!-- Text colors -->
        <item name="android:textColorPrimary">#222222</item>
        <item name="android:textColorSecondary">#666666</item>

        <!-- Status bar -->
        <item name="android:statusBarColor">#F7F5FC</item>
        <item name="android:navigationBarColor">#F7F5FC</item>

        <!-- Dark icons on light system bars -->
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>

    </style>

    <style
        name="Theme.SmartStudy"
        parent="Base.Theme.SmartStudy" />

</resources>